#!/usr/bin/env bash

set -euo pipefail

readonly plugin_id="fullerzz.sesh"
readonly plugin_ref="24ed45f9cb02886bfeecb36ccc367c2e22e3b4fd"
readonly plugin_version="0.10.1"

for required_command in git go herdr jq; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    printf 'install-herdr-sesh: required command not found: %s\n' "$required_command" >&2
    exit 1
  fi
done

export GOTOOLCHAIN=auto
herdr plugin install fullerzz/herdr-plugin-sesh --ref "$plugin_ref" --yes
plugins_json=$(herdr plugin list --json)

if ! jq -e \
  --arg plugin_id "$plugin_id" \
  --arg plugin_ref "$plugin_ref" \
  --arg plugin_version "$plugin_version" '
  [.result.plugins[] | select(.plugin_id == $plugin_id)] as $matches
  | ($matches | length) == 1
    and $matches[0].enabled
    and $matches[0].version == $plugin_version
    and $matches[0].source.resolved_commit == $plugin_ref
    and any($matches[0].actions[]; .id == "open-picker")
' <<<"$plugins_json" >/dev/null; then
  printf 'install-herdr-sesh: installed plugin metadata did not match the pinned release\n' >&2
  exit 1
fi
