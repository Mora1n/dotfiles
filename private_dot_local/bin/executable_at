#!/usr/bin/env bash

set -euo pipefail

die() {
  printf 'at: %s\n' "$*" >&2
  exit 1
}

for required_command in git realpath sha256sum tmux tmux-sessionizer; do
  command -v "$required_command" >/dev/null 2>&1 || die "required command not found: $required_command"
done

(( $# <= 1 )) || die "usage: at [directory]"
requested_dir=${1:-$PWD}
[[ -d "$requested_dir" ]] || die "directory does not exist: $requested_dir"
project_dir=$(realpath -- "$requested_dir")
if git_root=$(git -C "$project_dir" rev-parse --show-toplevel 2>/dev/null); then
  project_dir=$(realpath -- "$git_root")
fi

sanitize_name() {
  printf '%s' "$1" | tr '.:' '__'
}

connect_session() {
  if [[ -n ${TMUX:-} ]]; then
    exec tmux switch-client -t "=$1"
  fi
  exec tmux attach-session -t "=$1"
}

same_session_path() {
  local session_dir
  session_dir=$(tmux display-message -p -t "=$1:" '#{session_path}' 2>/dev/null) || return 1
  [[ $(realpath -m -- "$session_dir") == "$project_dir" ]]
}

base_name=$(basename -- "$project_dir")
[[ "$base_name" == / ]] && base_name=root
base_name=$(sanitize_name "$base_name")
session_name=$base_name
parent_dir=$(dirname -- "$project_dir")

while tmux has-session -t "=$session_name" 2>/dev/null; do
  same_session_path "$session_name" && connect_session "$session_name"
  if [[ "$parent_dir" == / ]]; then
    path_hash=$(printf '%s' "$project_dir" | sha256sum | cut -c1-8)
    session_name="${session_name}_${path_hash}"
    tmux has-session -t "=$session_name" 2>/dev/null && die "session name collision: $session_name"
    break
  fi
  session_name="$(sanitize_name "$(basename -- "$parent_dir")")_${session_name}"
  parent_dir=$(dirname -- "$parent_dir")
done

if [[ "$session_name" == "$base_name" && "$base_name" =~ ^[A-Za-z0-9_-]+$ ]]; then
  exec tmux-sessionizer "$project_dir"
fi

tmux new-session -d -s "$session_name" -c "$project_dir"
connect_session "$session_name"
