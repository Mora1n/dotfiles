#!/usr/bin/env bash

set -euo pipefail

die() {
  printf 'at: %s\n' "$*" >&2
  exit 1
}

(( $# <= 1 )) || die "usage: at [directory]"
command -v tmux >/dev/null 2>&1 || die "required command not found: tmux"

project_root() {
  local requested_dir=$1
  local resolved_dir git_root

  for required_command in git realpath sesh; do
    command -v "$required_command" >/dev/null 2>&1 || die "required command not found: $required_command"
  done
  [[ -d "$requested_dir" ]] || die "directory does not exist: $requested_dir"
  resolved_dir=$(realpath -- "$requested_dir")
  if git_root=$(git -C "$resolved_dir" rev-parse --show-toplevel 2>/dev/null); then
    resolved_dir=$(realpath -- "$git_root")
  fi
  printf '%s\n' "$resolved_dir"
}

has_sessions() {
  local session_ids

  session_ids=$(tmux list-sessions -F '#{session_id}' 2>/dev/null) || return 1
  [[ -n "$session_ids" ]]
}

start_project_session() {
  local project_dir=$1 session_name

  session_name=$(basename -- "$project_dir")
  [[ "$session_name" == / ]] && session_name=root
  session_name=${session_name//[.:]/_}
  exec tmux new-session -s "$session_name" -c "$project_dir"
}

switch_to_previous_session() {
  local current_session record candidate
  current_session=$(tmux display-message -p '#{session_name}')
  while IFS= read -r record; do
    candidate=${record#*$'\t'}
    if [[ "$candidate" != "$current_session" ]]; then
      exec tmux switch-client -t "=$candidate"
    fi
  done < <(tmux list-sessions -F $'#{session_last_attached}\t#{session_name}' | sort -rn)
  printf 'at: already in the only tmux session: %s\n' "$current_session" >&2
}

if (( $# == 1 )); then
  project_dir=$(project_root "$1")
  if has_sessions; then
    exec sesh connect "$project_dir"
  fi
  start_project_session "$project_dir"
fi

if has_sessions; then
  if [[ -n ${TMUX:-} ]]; then
    switch_to_previous_session
    exit 0
  fi
  exec tmux attach-session
fi

project_dir=$(project_root "$PWD")
start_project_session "$project_dir"
